<?xml version="1.0" encoding="utf-8"?>
<views:PageBase
    x:Class="LwWinApp.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:LwWinApp.Controls"
    xmlns:entities="using:LwWinApp.Models.Entities"
    xmlns:vm="using:LwWinApp.ViewModels"
    xmlns:views="using:LwWinApp.Views"
    mc:Ignorable="d">

    <Grid>
        <ScrollViewer Padding="24" VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="1280" HorizontalAlignment="Stretch" Spacing="16">

                <controls:PageHeader
                    Title="仪表盘"
                    Description="所有统计都来自一次并发查询批次：几个查询同时发出，最后一起等 —— 所以页面上不会出现「几个区块各自转圈」的观感。">
                    <controls:PageHeader.Actions>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock
                                VerticalAlignment="Center"
                                Style="{StaticResource CardCaptionTextStyle}"
                                Text="{x:Bind Vm.LastUpdated, Mode=OneWay}" />

                            <Button Command="{x:Bind Vm.RefreshCommand}" Style="{StaticResource ToolbarButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon FontSize="14" Glyph="&#xE72C;" />
                                    <TextBlock Text="刷新" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </controls:PageHeader.Actions>
                </controls:PageHeader>

                <!-- ============ 统计卡片 ============ -->
                <Grid ColumnSpacing="16" RowSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- 用户总数 -->
                    <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="6">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon
                                    FontSize="16"
                                    Foreground="{ThemeResource BrandPrimaryBrush}"
                                    Glyph="&#xE716;" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Style="{StaticResource CardCaptionTextStyle}"
                                    Text="用户总数" />
                            </StackPanel>

                            <TextBlock Style="{StaticResource StatValueTextStyle}" Text="{x:Bind Vm.TotalUsers, Mode=OneWay}" />

                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock
                                    Style="{StaticResource CardCaptionTextStyle}"
                                    Text="{x:Bind Vm.EnabledText, Mode=OneWay}" />
                                <TextBlock
                                    Style="{StaticResource CardCaptionTextStyle}"
                                    Text="{x:Bind Vm.DisabledText, Mode=OneWay}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- 角色 -->
                    <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="6">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon
                                    FontSize="16"
                                    Foreground="{ThemeResource InfoBrush}"
                                    Glyph="&#xE8D4;" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Style="{StaticResource CardCaptionTextStyle}"
                                    Text="角色数量" />
                            </StackPanel>

                            <TextBlock Style="{StaticResource StatValueTextStyle}" Text="{x:Bind Vm.TotalRoles, Mode=OneWay}" />
                            <TextBlock Style="{StaticResource CardCaptionTextStyle}" Text="sys_role" />
                        </StackPanel>
                    </Border>

                    <!-- 部门 -->
                    <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="6">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon
                                    FontSize="16"
                                    Foreground="{ThemeResource WarningBrush}"
                                    Glyph="&#xE8F4;" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Style="{StaticResource CardCaptionTextStyle}"
                                    Text="部门数量" />
                            </StackPanel>

                            <TextBlock Style="{StaticResource StatValueTextStyle}" Text="{x:Bind Vm.TotalDepts, Mode=OneWay}" />
                            <TextBlock Style="{StaticResource CardCaptionTextStyle}" Text="sys_dept" />
                        </StackPanel>
                    </Border>

                    <!-- 今日日志 -->
                    <Border Grid.Column="3" Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="6">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon
                                    FontSize="16"
                                    Foreground="{ThemeResource SuccessBrush}"
                                    Glyph="&#xE81C;" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Style="{StaticResource CardCaptionTextStyle}"
                                    Text="今日日志" />
                            </StackPanel>

                            <TextBlock Style="{StaticResource StatValueTextStyle}" Text="{x:Bind Vm.LogsToday, Mode=OneWay}" />
                            <TextBlock
                                Style="{StaticResource CardCaptionTextStyle}"
                                Text="{x:Bind Vm.ServerVersion, Mode=OneWay}" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ============ 启用比例 ============ -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock
                                Grid.Column="0"
                                Style="{StaticResource CardTitleTextStyle}"
                                Text="账号启用比例" />
                            <TextBlock
                                Grid.Column="1"
                                Style="{StaticResource CardTitleTextStyle}"
                                Text="{x:Bind Vm.EnabledRatioText, Mode=OneWay}" />
                        </Grid>

                        <ProgressBar
                            Maximum="100"
                            Minimum="0"
                            Value="{x:Bind Vm.EnabledRatio, Mode=OneWay}" />
                    </StackPanel>
                </Border>

                <!-- ============ 分布条形图 ============ -->
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardTitleTextStyle}" Text="按部门分布" />
                            <TextBlock
                                Style="{StaticResource CardCaptionTextStyle}"
                                Text="GROUP BY 聚合查询，取前 8 名。条形按最大值归一，不是按总数 —— 看的是相对多少，不是占比。" />

                            <ItemsControl Margin="0,14,0,0" ItemsSource="{x:Bind Vm.DeptBars, Mode=OneWay}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:DashboardBar">
                                        <Grid Padding="0,6" ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="110" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="50" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock
                                                Grid.Column="0"
                                                VerticalAlignment="Center"
                                                Style="{StaticResource TableCellTextStyle}"
                                                Text="{x:Bind Name}"
                                                TextTrimming="CharacterEllipsis" />

                                            <ProgressBar
                                                Grid.Column="1"
                                                VerticalAlignment="Center"
                                                Maximum="100"
                                                Minimum="0"
                                                Value="{x:Bind Percent}" />

                                            <TextBlock
                                                Grid.Column="2"
                                                VerticalAlignment="Center"
                                                Style="{StaticResource TableCellTextStyle}"
                                                Text="{x:Bind Count}"
                                                TextAlignment="Right" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardTitleTextStyle}" Text="按角色分布" />
                            <TextBlock Style="{StaticResource CardCaptionTextStyle}" Text="没有分配角色的用户会归到「未分配」这一项。" />

                            <ItemsControl Margin="0,14,0,0" ItemsSource="{x:Bind Vm.RoleBars, Mode=OneWay}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:DashboardBar">
                                        <Grid Padding="0,6" ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="110" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="50" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock
                                                Grid.Column="0"
                                                VerticalAlignment="Center"
                                                Style="{StaticResource TableCellTextStyle}"
                                                Text="{x:Bind Name}"
                                                TextTrimming="CharacterEllipsis" />

                                            <ProgressBar
                                                Grid.Column="1"
                                                VerticalAlignment="Center"
                                                Maximum="100"
                                                Minimum="0"
                                                Value="{x:Bind Percent}" />

                                            <TextBlock
                                                Grid.Column="2"
                                                VerticalAlignment="Center"
                                                Style="{StaticResource TableCellTextStyle}"
                                                Text="{x:Bind Count}"
                                                TextAlignment="Right" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ============ 最近日志 ============ -->
                <Border
                    Padding="0"
                    Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel
                            Grid.Row="0"
                            Margin="16,16,16,12"
                            Spacing="2">
                            <TextBlock Style="{StaticResource CardTitleTextStyle}" Text="最近操作" />
                            <TextBlock Style="{StaticResource CardCaptionTextStyle}" Text="最新 10 条 sys_log 记录。" />
                        </StackPanel>

                        <Border Grid.Row="1" Style="{StaticResource TableHeaderBorderStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="170" />
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="110" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Style="{StaticResource TableHeaderTextStyle}" Text="时间" />
                                <TextBlock Grid.Column="1" Style="{StaticResource TableHeaderTextStyle}" Text="等级" />
                                <TextBlock Grid.Column="2" Style="{StaticResource TableHeaderTextStyle}" Text="模块" />
                                <TextBlock Grid.Column="3" Style="{StaticResource TableHeaderTextStyle}" Text="内容" />
                                <TextBlock Grid.Column="4" Style="{StaticResource TableHeaderTextStyle}" Text="操作人" />
                            </Grid>
                        </Border>

                        <ListView
                            Grid.Row="2"
                            Height="320"
                            ItemContainerStyle="{StaticResource TableRowStyle}"
                            ItemsSource="{x:Bind Vm.RecentLogs, Mode=OneWay}"
                            SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="entities:SysLog">
                                    <Grid Height="40">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="170" />
                                            <ColumnDefinition Width="80" />
                                            <ColumnDefinition Width="130" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="110" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock
                                            Grid.Column="0"
                                            Style="{StaticResource TableCellTextStyle}"
                                            Text="{x:Bind CreateTimeText}" />

                                        <Border
                                            Grid.Column="1"
                                            Margin="12,0"
                                            Padding="8,2"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            Background="{ThemeResource DangerSubtleBrush}"
                                            CornerRadius="10"
                                            Visibility="{x:Bind IsProblem}">
                                            <TextBlock
                                                FontSize="12"
                                                Foreground="{ThemeResource DangerBrush}"
                                                Text="{x:Bind LevelText}" />
                                        </Border>

                                        <Border
                                            Grid.Column="1"
                                            Margin="12,0"
                                            Padding="8,2"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            Background="{ThemeResource WarningSubtleBrush}"
                                            CornerRadius="10"
                                            Visibility="{x:Bind IsWarning}">
                                            <TextBlock
                                                FontSize="12"
                                                Foreground="{ThemeResource WarningBrush}"
                                                Text="{x:Bind LevelText}" />
                                        </Border>

                                        <Border
                                            Grid.Column="1"
                                            Margin="12,0"
                                            Padding="8,2"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            Background="{ThemeResource TableRowAltBrush}"
                                            CornerRadius="10"
                                            Visibility="{x:Bind IsNormal}">
                                            <TextBlock
                                                FontSize="12"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="{x:Bind LevelText}" />
                                        </Border>

                                        <TextBlock
                                            Grid.Column="2"
                                            Style="{StaticResource TableCellTextStyle}"
                                            Text="{x:Bind Module}" />
                                        <TextBlock
                                            Grid.Column="3"
                                            Style="{StaticResource TableCellTextStyle}"
                                            Text="{x:Bind Message}" />
                                        <TextBlock
                                            Grid.Column="4"
                                            Style="{StaticResource TableCellTextStyle}"
                                            Text="{x:Bind UserNameDisplay}" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <controls:BusyOverlay IsActive="{x:Bind Vm.IsBusy, Mode=OneWay}" Text="正在统计…" />
    </Grid>
</views:PageBase>
