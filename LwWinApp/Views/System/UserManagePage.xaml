<?xml version="1.0" encoding="utf-8"?>
<views:PageBase
    x:Class="LwWinApp.Views.System.UserManagePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:LwWinApp.Controls"
    xmlns:entities="using:LwWinApp.Models.Entities"
    xmlns:views="using:LwWinApp.Views"
    mc:Ignorable="d">

    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <controls:PageHeader
            Grid.Row="0"
            Title="用户管理"
            Description="全部数据来自 MySQL 的 sys_user 表：筛选、分页、增删改、导出都走 UserService → 仓储 → 数据库这条链路。">
            <controls:PageHeader.Actions>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Command="{x:Bind Vm.CreateCommand}" Style="{StaticResource ToolbarButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="14" Glyph="&#xE710;" />
                            <TextBlock Text="新增用户" />
                        </StackPanel>
                    </Button>

                    <Button Command="{x:Bind Vm.ExportCommand}" Style="{StaticResource ToolbarButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="14" Glyph="&#xE896;" />
                            <TextBlock Text="导出" />
                        </StackPanel>
                    </Button>

                    <Button
                        Command="{x:Bind Vm.RefreshCommand}"
                        Style="{StaticResource ToolbarButtonStyle}"
                        ToolTipService.ToolTip="重新加载">
                        <FontIcon FontSize="14" Glyph="&#xE72C;" />
                    </Button>
                </StackPanel>
            </controls:PageHeader.Actions>
        </controls:PageHeader>

        <!-- ============ 筛选条 ============ -->
        <Border Grid.Row="1" Style="{StaticResource ToolbarStyle}">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBox
                    Width="200"
                    KeyDown="OnKeywordKeyDown"
                    PlaceholderText="账号 / 姓名 / 邮箱"
                    Text="{x:Bind Vm.Keyword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                <ComboBox
                    Width="130"
                    DisplayMemberPath="Text"
                    ItemsSource="{x:Bind Vm.StatusFilterOptions}"
                    SelectedItem="{x:Bind Vm.SelectedStatus, Mode=TwoWay}" />

                <ComboBox
                    Width="130"
                    DisplayMemberPath="Text"
                    ItemsSource="{x:Bind Vm.GenderFilterOptions}"
                    SelectedItem="{x:Bind Vm.SelectedGender, Mode=TwoWay}" />

                <ComboBox
                    Width="160"
                    DisplayMemberPath="Text"
                    ItemsSource="{x:Bind Vm.DeptFilterOptions, Mode=OneWay}"
                    SelectedItem="{x:Bind Vm.SelectedDept, Mode=TwoWay}" />

                <ComboBox
                    Width="140"
                    DisplayMemberPath="Text"
                    ItemsSource="{x:Bind Vm.RoleFilterOptions, Mode=OneWay}"
                    SelectedItem="{x:Bind Vm.SelectedRole, Mode=TwoWay}" />

                <Button Command="{x:Bind Vm.SearchCommand}" Style="{StaticResource ToolbarButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="14" Glyph="&#xE721;" />
                        <TextBlock Text="查询" />
                    </StackPanel>
                </Button>

                <Button
                    Command="{x:Bind Vm.ResetFilterCommand}"
                    IsEnabled="{x:Bind Vm.HasFilter, Mode=OneWay}"
                    Content="重置"
                    Style="{StaticResource ToolbarButtonStyle}" />
            </StackPanel>
        </Border>

        <!-- ============ 表格 ============ -->
        <Border
            Grid.Row="2"
            Padding="0"
            Style="{StaticResource CardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 表头 -->
                <Border Grid.Row="0" Style="{StaticResource TableHeaderBorderStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="70" />
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="190" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Style="{StaticResource TableHeaderTextStyle}" Text="登录账号" />
                        <TextBlock Grid.Column="1" Style="{StaticResource TableHeaderTextStyle}" Text="姓名" />
                        <TextBlock Grid.Column="2" Style="{StaticResource TableHeaderTextStyle}" Text="性别" />
                        <TextBlock Grid.Column="3" Style="{StaticResource TableHeaderTextStyle}" Text="部门" />
                        <TextBlock Grid.Column="4" Style="{StaticResource TableHeaderTextStyle}" Text="角色" />
                        <TextBlock Grid.Column="5" Style="{StaticResource TableHeaderTextStyle}" Text="邮箱" />
                        <TextBlock Grid.Column="6" Style="{StaticResource TableHeaderTextStyle}" Text="手机号" />
                        <TextBlock Grid.Column="7" Style="{StaticResource TableHeaderTextStyle}" Text="状态" />
                        <TextBlock Grid.Column="8" Style="{StaticResource TableHeaderTextStyle}" Text="操作" />
                    </Grid>
                </Border>

                <!-- 空数据提示：盖在列表上，列表没数据时才显示 -->
                <TextBlock
                    Grid.Row="1"
                    Margin="0,40,0,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Style="{StaticResource CardCaptionTextStyle}"
                    Text="{x:Bind Vm.EmptyHint, Mode=OneWay}"
                    Visibility="{x:Bind Vm.Items, Mode=OneWay, Converter={StaticResource EmptyCollectionToVisibilityConverter}}" />

                <ListView
                    Grid.Row="1"
                    ItemsSource="{x:Bind Vm.Items, Mode=OneWay}"
                    ItemContainerStyle="{StaticResource TableRowStyle}"
                    SelectedItem="{x:Bind Vm.SelectedUser, Mode=TwoWay}"
                    SelectionMode="Single">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="entities:SysUser">
                            <Grid Height="44">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="70" />
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="190" />
                                </Grid.ColumnDefinitions>

                                <TextBlock
                                    Grid.Column="0"
                                    Style="{StaticResource TableCellTextStyle}"
                                    Text="{x:Bind UserName}" />
                                <TextBlock
                                    Grid.Column="1"
                                    Style="{StaticResource TableCellTextStyle}"
                                    Text="{x:Bind RealName}" />
                                <TextBlock
                                    Grid.Column="2"
                                    Style="{StaticResource TableCellTextStyle}"
                                    Text="{x:Bind GenderText}" />
                                <TextBlock
                                    Grid.Column="3"
                                    Style="{StaticResource TableCellTextStyle}"
                                    Text="{x:Bind DeptDisplay}" />
                                <TextBlock
                                    Grid.Column="4"
                                    Style="{StaticResource TableCellTextStyle}"
                                    Text="{x:Bind RoleDisplay}" />
                                <TextBlock
                                    Grid.Column="5"
                                    Style="{StaticResource TableCellTextStyle}"
                                    Text="{x:Bind Email}" />
                                <TextBlock
                                    Grid.Column="6"
                                    Style="{StaticResource TableCellTextStyle}"
                                    Text="{x:Bind Phone}" />

                                <!--
                                    状态徽标。两个 Border 各管一种状态，用 Visibility 切换 ——
                                    x:Bind 能把 bool 直接转成 Visibility，不用额外写转换器。
                                -->
                                <Border
                                    Grid.Column="7"
                                    Margin="12,0"
                                    Padding="8,2"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Background="{ThemeResource SuccessSubtleBrush}"
                                    CornerRadius="10"
                                    Visibility="{x:Bind IsEnabled}">
                                    <TextBlock
                                        FontSize="12"
                                        Foreground="{ThemeResource SuccessBrush}"
                                        Text="{x:Bind StatusText}" />
                                </Border>

                                <Border
                                    Grid.Column="7"
                                    Margin="12,0"
                                    Padding="8,2"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Background="{ThemeResource DangerSubtleBrush}"
                                    CornerRadius="10"
                                    Visibility="{x:Bind IsDisabled}">
                                    <TextBlock
                                        FontSize="12"
                                        Foreground="{ThemeResource DangerBrush}"
                                        Text="{x:Bind StatusText}" />
                                </Border>

                                <StackPanel
                                    Grid.Column="8"
                                    Orientation="Horizontal"
                                    Spacing="2">
                                    <Button
                                        Click="OnEditClick"
                                        Style="{StaticResource IconButtonStyle}"
                                        Tag="{x:Bind}"
                                        ToolTipService.ToolTip="编辑">
                                        <FontIcon FontSize="13" Glyph="&#xE70F;" />
                                    </Button>

                                    <Button
                                        Click="OnToggleStatusClick"
                                        Style="{StaticResource IconButtonStyle}"
                                        Tag="{x:Bind}"
                                        ToolTipService.ToolTip="启用 / 停用">
                                        <FontIcon FontSize="13" Glyph="&#xE8D8;" />
                                    </Button>

                                    <Button
                                        Click="OnResetPasswordClick"
                                        Style="{StaticResource IconButtonStyle}"
                                        Tag="{x:Bind}"
                                        ToolTipService.ToolTip="重置密码">
                                        <FontIcon FontSize="13" Glyph="&#xE8D7;" />
                                    </Button>

                                    <Button
                                        Click="OnDeleteClick"
                                        Style="{StaticResource IconButtonStyle}"
                                        Tag="{x:Bind}"
                                        ToolTipService.ToolTip="删除">
                                        <FontIcon
                                            FontSize="13"
                                            Foreground="{ThemeResource DangerBrush}"
                                            Glyph="&#xE74D;" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>

        <controls:Pager
            Grid.Row="3"
            PageIndex="{x:Bind Vm.PageIndex, Mode=TwoWay}"
            PageSize="{x:Bind Vm.PageSize, Mode=TwoWay}"
            PageSizeOptions="{x:Bind Vm.PageSizeOptions}"
            Total="{x:Bind Vm.Total, Mode=OneWay}" />

        <controls:BusyOverlay
            Grid.RowSpan="4"
            IsActive="{x:Bind Vm.IsBusy, Mode=OneWay}"
            Text="正在加载用户数据…" />
    </Grid>
</views:PageBase>
