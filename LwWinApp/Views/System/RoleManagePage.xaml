<?xml version="1.0" encoding="utf-8"?>
<views:PageBase
    x:Class="LwWinApp.Views.System.RoleManagePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:LwWinApp.Controls"
    xmlns:entities="using:LwWinApp.Models.Entities"
    xmlns:views="using:LwWinApp.Views"
    mc:Ignorable="d">

    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <controls:PageHeader
            Grid.Row="0"
            Title="角色管理"
            Description="结构照搬用户管理，只是筛选字段少一些 —— 通用仓储和 Service 层在这里被复用了一遍。">
            <controls:PageHeader.Actions>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Command="{x:Bind Vm.CreateCommand}" Style="{StaticResource ToolbarButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="14" Glyph="&#xE710;" />
                            <TextBlock Text="新增角色" />
                        </StackPanel>
                    </Button>

                    <Button Command="{x:Bind Vm.ExportCommand}" Style="{StaticResource ToolbarButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="14" Glyph="&#xE896;" />
                            <TextBlock Text="导出" />
                        </StackPanel>
                    </Button>

                    <Button
                        Command="{x:Bind Vm.RefreshCommand}"
                        Style="{StaticResource ToolbarButtonStyle}"
                        ToolTipService.ToolTip="重新加载">
                        <FontIcon FontSize="14" Glyph="&#xE72C;" />
                    </Button>
                </StackPanel>
            </controls:PageHeader.Actions>
        </controls:PageHeader>

        <Border Grid.Row="1" Style="{StaticResource ToolbarStyle}">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBox
                    Width="220"
                    KeyDown="OnKeywordKeyDown"
                    PlaceholderText="角色编码 / 名称"
                    Text="{x:Bind Vm.Keyword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                <ComboBox
                    Width="130"
                    DisplayMemberPath="Text"
                    ItemsSource="{x:Bind Vm.StatusFilterOptions}"
                    SelectedItem="{x:Bind Vm.SelectedStatus, Mode=TwoWay}" />

                <Button Command="{x:Bind Vm.SearchCommand}" Style="{StaticResource ToolbarButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="14" Glyph="&#xE721;" />
                        <TextBlock Text="查询" />
                    </StackPanel>
                </Button>

                <Button
                    Command="{x:Bind Vm.ResetFilterCommand}"
                    IsEnabled="{x:Bind Vm.HasFilter, Mode=OneWay}"
                    Content="重置"
                    Style="{StaticResource ToolbarButtonStyle}" />
            </StackPanel>
        </Border>

        <Border
            Grid.Row="2"
            Padding="0"
            Style="{StaticResource CardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource TableHeaderBorderStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="100" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Style="{StaticResource TableHeaderTextStyle}" Text="角色编码" />
                        <TextBlock Grid.Column="1" Style="{StaticResource TableHeaderTextStyle}" Text="角色名称" />
                        <TextBlock Grid.Column="2" Style="{StaticResource TableHeaderTextStyle}" Text="排序" />
                        <TextBlock Grid.Column="3" Style="{StaticResource TableHeaderTextStyle}" Text="关联用户" />
                        <TextBlock Grid.Column="4" Style="{StaticResource TableHeaderTextStyle}" Text="状态" />
                        <TextBlock Grid.Column="5" Style="{StaticResource TableHeaderTextStyle}" Text="备注" />
                        <TextBlock Grid.Column="6" Style="{StaticResource TableHeaderTextStyle}" Text="创建时间" />
                        <TextBlock Grid.Column="7" Style="{StaticResource TableHeaderTextStyle}" Text="操作" />
                    </Grid>
                </Border>

                <TextBlock
                    Grid.Row="1"
                    Margin="0,40,0,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Style="{StaticResource CardCaptionTextStyle}"
                    Text="{x:Bind Vm.EmptyHint, Mode=OneWay}"
                    Visibility="{x:Bind Vm.Items, Mode=OneWay, Converter={StaticResource EmptyCollectionToVisibilityConverter}}" />

                <ListView
                    Grid.Row="1"
                    ItemContainerStyle="{StaticResource TableRowStyle}"
                    ItemsSource="{x:Bind Vm.Items, Mode=OneWay}"
                    SelectedItem="{x:Bind Vm.SelectedRole, Mode=TwoWay}"
                    SelectionMode="Single">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="entities:SysRole">
                            <Grid Height="44">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition Width="180" />
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition Width="100" />
                                </Grid.ColumnDefinitions>

                                <TextBlock
                                    Grid.Column="0"
                                    Style="{StaticResource TableCellTextStyle}"
                                    Text="{x:Bind RoleCode}" />
                                <TextBlock
                                    Grid.Column="1"
                                    Style="{StaticResource TableCellTextStyle}"
                                    Text="{x:Bind RoleName}" />
                                <TextBlock
                                    Grid.Column="2"
                                    Style="{StaticResource TableCellTextStyle}"
                                    Text="{x:Bind SortText}" />
                                <TextBlock
                                    Grid.Column="3"
                                    Style="{StaticResource TableCellTextStyle}"
                                    Text="{x:Bind UserCountText}" />
                                <TextBlock
                                    Grid.Column="5"
                                    Style="{StaticResource TableCellTextStyle}"
                                    Text="{x:Bind RemarkDisplay}" />
                                <TextBlock
                                    Grid.Column="6"
                                    Style="{StaticResource TableCellTextStyle}"
                                    Text="{x:Bind CreateTimeText}" />

                                <Border
                                    Grid.Column="4"
                                    Margin="12,0"
                                    Padding="8,2"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Background="{ThemeResource SuccessSubtleBrush}"
                                    CornerRadius="10"
                                    Visibility="{x:Bind IsEnabled}">
                                    <TextBlock
                                        FontSize="12"
                                        Foreground="{ThemeResource SuccessBrush}"
                                        Text="{x:Bind StatusText}" />
                                </Border>

                                <Border
                                    Grid.Column="4"
                                    Margin="12,0"
                                    Padding="8,2"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Background="{ThemeResource DangerSubtleBrush}"
                                    CornerRadius="10"
                                    Visibility="{x:Bind IsDisabled}">
                                    <TextBlock
                                        FontSize="12"
                                        Foreground="{ThemeResource DangerBrush}"
                                        Text="{x:Bind StatusText}" />
                                </Border>

                                <StackPanel
                                    Grid.Column="7"
                                    Orientation="Horizontal"
                                    Spacing="2">
                                    <Button
                                        Click="OnEditClick"
                                        Style="{StaticResource IconButtonStyle}"
                                        Tag="{x:Bind}"
                                        ToolTipService.ToolTip="编辑">
                                        <FontIcon FontSize="13" Glyph="&#xE70F;" />
                                    </Button>

                                    <Button
                                        Click="OnToggleStatusClick"
                                        Style="{StaticResource IconButtonStyle}"
                                        Tag="{x:Bind}"
                                        ToolTipService.ToolTip="启用 / 停用">
                                        <FontIcon FontSize="13" Glyph="&#xE8D8;" />
                                    </Button>

                                    <Button
                                        Click="OnDeleteClick"
                                        Style="{StaticResource IconButtonStyle}"
                                        Tag="{x:Bind}"
                                        ToolTipService.ToolTip="删除">
                                        <FontIcon
                                            FontSize="13"
                                            Foreground="{ThemeResource DangerBrush}"
                                            Glyph="&#xE74D;" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>

        <controls:Pager
            Grid.Row="3"
            PageIndex="{x:Bind Vm.PageIndex, Mode=TwoWay}"
            PageSize="{x:Bind Vm.PageSize, Mode=TwoWay}"
            PageSizeOptions="{x:Bind Vm.PageSizeOptions}"
            Total="{x:Bind Vm.Total, Mode=OneWay}" />

        <controls:BusyOverlay
            Grid.RowSpan="4"
            IsActive="{x:Bind Vm.IsBusy, Mode=OneWay}"
            Text="正在加载角色数据…" />
    </Grid>
</views:PageBase>
