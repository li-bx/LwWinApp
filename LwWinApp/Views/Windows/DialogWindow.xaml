<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="LwWinApp.Views.Windows.DialogWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!--
        通用弹窗窗口的壳：一行说明 + 正文 + 一排按钮，别的什么都不做。
        正文由调用方塞进来（Body），所以同一个壳既能当确认框，也能装下一整张表单。

        刻意用系统标题栏（不 ExtendsContentIntoTitleBar）：
        拖动、关闭按钮、双击最大化这些交给系统，代码里就少一处要跟着系统版本维护的自绘标题栏；
        而且模态窗口上系统标题栏会随着 OverlappedPresenter 的设置自动去掉最大化/最小化按钮，
        正是 Windows 上对话框该有的样子。

        背景要显式给：窗口不会自己刷底色，正文里没被盖住的地方会透出下面一层。
    -->
    <Grid
        x:Name="RootGrid"
        Padding="24"
        Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock
            x:Name="DescriptionText"
            Grid.Row="0"
            Margin="0,0,0,16"
            Style="{StaticResource CardCaptionTextStyle}"
            TextWrapping="Wrap"
            Visibility="Collapsed" />

        <!--
            正文外面套一层滚动：窗口是按逻辑像素定好大小的，正文却可能长过它
            （表单窗口在校验失败时顶部会多出一条错误提示，正好就是这种时候）。
            撑不下就滚，总比把按钮或输入框裁掉强。
        -->
        <ScrollViewer
            Grid.Row="1"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
            <ContentPresenter x:Name="BodyHost" />
        </ScrollViewer>

        <!--
            两个按钮都从「不显示」起步，由 PrimaryButtonText / CloseButtonText 决定露不露脸。
            整个按钮条也要一起收掉：留一个空条在那里，窗口底部会莫名多出一条边。
            间距一律用 Margin 而不是 Grid 的 RowSpacing —— 后者对收掉的元素照样生效。
        -->
        <StackPanel
            x:Name="ButtonBar"
            Grid.Row="2"
            Margin="0,16,0,0"
            HorizontalAlignment="Right"
            Orientation="Horizontal"
            Spacing="8"
            Visibility="Collapsed">
            <Button
                x:Name="CloseButton"
                Click="OnCloseClick"
                Style="{StaticResource ToolbarButtonStyle}"
                Visibility="Collapsed" />
            <Button
                x:Name="PrimaryButton"
                Click="OnPrimaryClick"
                Style="{StaticResource AccentButtonStyle}"
                Visibility="Collapsed" />
        </StackPanel>

        <!--
            Esc = 取消，回车 = 主按钮，和 Windows 上的对话框一致。
            挂在根 Grid 上就够了：按键会从焦点元素冒泡上来，正文里的输入框也走这条路径；
            输入框自己处理掉 Enter（比如多行文本框）时压根不会冒到这里，不会误触发提交。
        -->
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="Escape" Invoked="OnEscapeInvoked" />
            <KeyboardAccelerator Key="Enter" Invoked="OnEnterInvoked" />
        </Grid.KeyboardAccelerators>
    </Grid>
</Window>
