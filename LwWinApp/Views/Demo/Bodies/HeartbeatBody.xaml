<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="LwWinApp.Views.Demo.Bodies.HeartbeatBody"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!-- 非模态窗口里的正文：自己跑一个定时器，用来证明主窗口确实没被锁住。 -->
    <StackPanel Spacing="12">
        <TextBlock
            Style="{StaticResource CardCaptionTextStyle}"
            Text="下面这个计时由窗口自己驱动。切回主窗口点别的按钮、再开别的标签，它都不会停 —— 因为非模态窗口压根没去锁属主。"
            TextWrapping="Wrap" />

        <Border Style="{StaticResource CardStyle}">
            <StackPanel Spacing="4">
                <TextBlock Style="{StaticResource CardCaptionTextStyle}" Text="已运行" />
                <TextBlock
                    x:Name="ElapsedText"
                    Style="{StaticResource StatValueTextStyle}"
                    Text="00:00" />
                <TextBlock x:Name="BeatText" Style="{StaticResource CardCaptionTextStyle}" />
            </StackPanel>
        </Border>

        <StackPanel Orientation="Horizontal" Spacing="8">
            <Button
                x:Name="ToggleButton"
                Click="OnToggleClick"
                Style="{StaticResource ToolbarButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon x:Name="ToggleIcon" FontSize="14" Glyph="&#xE769;" />
                    <TextBlock x:Name="ToggleText" Text="暂停" />
                </StackPanel>
            </Button>

            <TextBlock
                VerticalAlignment="Center"
                Style="{StaticResource CardCaptionTextStyle}"
                Text="暂停只是停这个窗口的计时，主窗口任何时候都能用。" />
        </StackPanel>
    </StackPanel>
</UserControl>
