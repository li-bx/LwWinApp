<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="LwWinApp.Views.Demo.Bodies.TicketFormBody"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!-- 弹窗窗口里装一整张表单 —— 这正是 ContentDialog 撑不住、必须换成真窗口的场景。 -->
    <StackPanel Spacing="0">

        <InfoBar
            x:Name="ErrorBar"
            Margin="0,0,0,12"
            IsClosable="False"
            IsOpen="False"
            Severity="Error" />

        <StackPanel Style="{StaticResource FormFieldPanelStyle}">
            <TextBlock Style="{StaticResource FormLabelTextStyle}" Text="工单标题 *" />
            <TextBox x:Name="TitleBox" PlaceholderText="一句话说清楚问题" />
        </StackPanel>

        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Style="{StaticResource FormFieldPanelStyle}">
                <TextBlock Style="{StaticResource FormLabelTextStyle}" Text="优先级" />
                <ComboBox
                    x:Name="PriorityBox"
                    HorizontalAlignment="Stretch"
                    DisplayMemberPath="Text" />
            </StackPanel>

            <StackPanel Grid.Column="1" Style="{StaticResource FormFieldPanelStyle}">
                <TextBlock Style="{StaticResource FormLabelTextStyle}" Text="影响范围" />
                <ComboBox
                    x:Name="ScopeBox"
                    HorizontalAlignment="Stretch"
                    DisplayMemberPath="Text" />
            </StackPanel>
        </Grid>

        <StackPanel Style="{StaticResource FormFieldPanelStyle}">
            <TextBlock Style="{StaticResource FormLabelTextStyle}" Text="详细描述" />
            <TextBox
                x:Name="DetailBox"
                Height="84"
                AcceptsReturn="True"
                MaxLength="500"
                PlaceholderText="复现步骤、报错原文…"
                TextWrapping="Wrap" />
        </StackPanel>

        <TextBlock
            Style="{StaticResource HintTextStyle}"
            Text="带 * 的是必填项。留空点提交不会关窗口 —— 校验逻辑挂在窗口的主按钮上，见 WindowDemoViewModel。" />
    </StackPanel>
</UserControl>
