<?xml version="1.0" encoding="utf-8"?>
<views:PageBase
    x:Class="LwWinApp.Views.Demo.ProgressDemoPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:LwWinApp.Controls"
    xmlns:demo="using:LwWinApp.ViewModels.Demo"
    xmlns:views="using:LwWinApp.Views"
    mc:Ignorable="d">

    <Grid>
        <ScrollViewer Padding="24" VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="1100" HorizontalAlignment="Stretch" Spacing="16">

                <controls:PageHeader
                    Title="进度与加载"
                    Description="知道总量用确定值进度条，不知道总量用不确定值，整页在等就用遮罩。选错语义比画得难看更让人困惑。" />

                <InfoBar
                    IsClosable="False"
                    IsOpen="True"
                    Message="{x:Bind Vm.ErrorMessage, Mode=OneWay, FallbackValue=就绪}"
                    Severity="Warning"
                    Title="任务提示" />

                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- ============ 确定值 ============ -->
                    <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="确定值进度条" />
                            <TextBlock Style="{StaticResource CardCaptionTextStyle}" Text="任务总量已知（导 500 条、下 20 个文件），进度才有意义。" />

                            <TextBlock
                                Margin="0,16,0,0"
                                Style="{StaticResource StatValueTextStyle}"
                                Text="{x:Bind Vm.ProgressText, Mode=OneWay}" />

                            <ProgressBar
                                Margin="0,4,0,0"
                                Maximum="100"
                                Minimum="0"
                                Value="{x:Bind Vm.ProgressValue, Mode=TwoWay}" />

                            <StackPanel
                                Margin="0,12,0,0"
                                Orientation="Horizontal"
                                Spacing="10">
                                <Button Command="{x:Bind Vm.StepCommand}" Content="+10%" Style="{StaticResource ToolbarButtonStyle}" />
                                <Button Command="{x:Bind Vm.ResetProgressCommand}" Content="归零" Style="{StaticResource ToolbarButtonStyle}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- ============ 不确定值 ============ -->
                    <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="不确定值 / 转圈" />
                            <TextBlock Style="{StaticResource CardCaptionTextStyle}" Text="只用来说明「还在干活」，不要配一个假百分比 —— 那是骗人的。" />

                            <StackPanel
                                Margin="0,16,0,0"
                                Orientation="Horizontal"
                                Spacing="24">
                                <ProgressBar
                                    Width="180"
                                    VerticalAlignment="Center"
                                    IsIndeterminate="{x:Bind Vm.IsIndeterminateActive, Mode=OneWay}" />
                                <ProgressRing
                                    Width="36"
                                    Height="36"
                                    IsActive="{x:Bind Vm.IsIndeterminateActive, Mode=OneWay}" />
                            </StackPanel>

                            <Button
                                Margin="0,12,0,0"
                                Command="{x:Bind Vm.ToggleIndeterminateCommand}"
                                Content="开 / 关"
                                Style="{StaticResource ToolbarButtonStyle}" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ============ 分步进度 ============ -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="分步进度" />
                                <TextBlock
                                    Style="{StaticResource CardCaptionTextStyle}"
                                    Text="多阶段任务只给一根进度条，用户看到卡住会以为死了。分步列表能告诉他「卡在哪一步、下一步是什么」。这个示例故意让第 4 步失败。" />
                            </StackPanel>

                            <StackPanel
                                Grid.Column="1"
                                VerticalAlignment="Top"
                                Orientation="Horizontal"
                                Spacing="10">
                                <Button
                                    Command="{x:Bind Vm.RunStepsCommand}"
                                    IsEnabled="{x:Bind Vm.IsStepTaskRunning, Mode=OneWay, Converter={StaticResource NotBoolConverter}}"
                                    Style="{StaticResource ToolbarButtonStyle}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon FontSize="14" Glyph="&#xE768;" />
                                        <TextBlock Text="执行分步任务" />
                                    </StackPanel>
                                </Button>

                                <Button Command="{x:Bind Vm.RunStepsInDialogCommand}" Style="{StaticResource ToolbarButtonStyle}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon FontSize="14" Glyph="&#xE8B2;" />
                                        <TextBlock Text="在对话框中执行" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <ProgressBar
                            Margin="0,16,0,0"
                            Maximum="100"
                            Minimum="0"
                            Value="{x:Bind Vm.StepPercent, Mode=OneWay}" />

                        <TextBlock
                            Margin="0,6,0,0"
                            Style="{StaticResource HintTextStyle}"
                            Text="{x:Bind Vm.StepSummary, Mode=OneWay}" />

                        <ItemsControl Margin="0,12,0,0" ItemsSource="{x:Bind Vm.Steps}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="demo:ProgressStep">
                                    <Grid Padding="0,8" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <FontIcon
                                            Grid.Column="0"
                                            FontSize="16"
                                            Glyph="{x:Bind StateGlyph, Mode=OneWay}" />

                                        <TextBlock
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource CardTitleTextStyle}"
                                            Text="{x:Bind Title}" />

                                        <TextBlock
                                            Grid.Column="2"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource CardCaptionTextStyle}"
                                            Text="{x:Bind Detail, Mode=OneWay}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- ============ 页面级遮罩 ============ -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="页面级忙碌遮罩" />
                        <TextBlock
                            Style="{StaticResource CardCaptionTextStyle}"
                            Text="盖住整页的等待。它的作用不只是转圈，更是挡住用户在数据没准备好时乱点 —— 半加载状态下点出来的操作往往更难收拾。" />

                        <StackPanel
                            Margin="0,16,0,0"
                            Orientation="Horizontal"
                            Spacing="10">
                            <Button
                                Command="{x:Bind Vm.StartOverlayTaskCommand}"
                                IsEnabled="{x:Bind Vm.IsOverlayActive, Mode=OneWay, Converter={StaticResource NotBoolConverter}}"
                                Style="{StaticResource ToolbarButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon FontSize="14" Glyph="&#xE895;" />
                                    <TextBlock Text="开始加载（2 秒）" />
                                </StackPanel>
                            </Button>

                            <Button
                                Command="{x:Bind Vm.CancelOverlayTaskCommand}"
                                IsEnabled="{x:Bind Vm.CanCancelTask, Mode=OneWay}"
                                Content="取消" />
                        </StackPanel>

                        <Border Height="120" Margin="0,12,0,0" Style="{StaticResource CodeBlockStyle}">
                            <TextBlock Style="{StaticResource CodeTextStyle}">
&lt;Grid&gt;
    &lt;!-- 页面内容 --&gt;
    &lt;StackPanel&gt;…&lt;/StackPanel&gt;

    &lt;!-- 遮罩放在最后：XAML 里后写的在上层 --&gt;
    &lt;controls:BusyOverlay IsActive="{x:Bind Vm.IsBusy, Mode=OneWay}" /&gt;
&lt;/Grid&gt;</TextBlock>
                        </Border>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <controls:BusyOverlay IsActive="{x:Bind Vm.IsOverlayActive, Mode=OneWay}" Text="{x:Bind Vm.BusyText, Mode=OneWay}" />
    </Grid>
</views:PageBase>
