<?xml version="1.0" encoding="utf-8"?>
<views:PageBase
    x:Class="LwWinApp.Views.Demo.WindowDemoPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:LwWinApp.Controls"
    xmlns:views="using:LwWinApp.Views"
    mc:Ignorable="d">

    <ScrollViewer Padding="24" VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="1100" HorizontalAlignment="Stretch" Spacing="16">

            <controls:PageHeader
                Title="弹窗窗口"
                Description="真正的窗口，不是主窗口里的一块浮层。WinUI 3 没有原生模态窗口 —— 这里是它该有的样子，以及什么时候值得用窗口而不是 ContentDialog。" />

            <InfoBar
                IsClosable="False"
                IsOpen="True"
                Message="{x:Bind Vm.LastResult, Mode=OneWay}"
                Severity="Informational"
                Title="最近一次结果" />

            <!-- ============ 模态窗口 ============ -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="模态窗口" />
                    <TextBlock
                        Style="{StaticResource CardCaptionTextStyle}"
                        Text="打开的那一刻属主窗口就被锁住：点它、按 Alt+Tab 切过去，都只会听到一声提示音。关掉之后焦点自动还回来。" />

                    <StackPanel
                        Margin="0,16,0,0"
                        Orientation="Horizontal"
                        Spacing="10">
                        <Button Command="{x:Bind Vm.ShowMessageWindowCommand}" Style="{StaticResource ToolbarButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontSize="14" Glyph="&#xE946;" />
                                <TextBlock Text="消息窗口" />
                            </StackPanel>
                        </Button>

                        <Button Command="{x:Bind Vm.ShowConfirmWindowCommand}" Style="{StaticResource ToolbarButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontSize="14" Glyph="&#xE8BD;" />
                                <TextBlock Text="确认窗口" />
                            </StackPanel>
                        </Button>

                        <Button Command="{x:Bind Vm.ShowFormWindowCommand}" Style="{StaticResource ToolbarButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontSize="14" Glyph="&#xE70F;" />
                                <TextBlock Text="表单窗口（带校验）" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <Border Style="{StaticResource CodeBlockStyle}">
                        <TextBlock Style="{StaticResource CodeTextStyle}">
// 窗口自己只描述「长什么样」，怎么显示交给服务
var result = await _windows.ShowModalAsync(new DialogWindow
{
    Title = "提交工单",
    Body = new TicketFormBody(...),
    PrimaryButtonText = "提交",
    CloseButtonText = "取消"
});

// 校验不通过就把窗口留住，用户刚填的一个字都不会丢
window.PrimaryButtonClick += (_, args) => args.Cancel = !body.Validate();</TextBlock>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ============ 嵌套的模态窗口 ============ -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="嵌套的模态窗口" />
                    <TextBlock
                        Style="{StaticResource CardCaptionTextStyle}"
                        Text="模态窗口还能再叠一层。每叠一层，被锁住的就多一个窗口；关掉一层只解开它下面那一层 —— 所以主窗口全程都点不动，直到最外层也关掉。" />

                    <Button
                        Margin="0,16,0,0"
                        Command="{x:Bind Vm.ShowNestedWindowCommand}"
                        Style="{StaticResource ToolbarButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="14" Glyph="&#xE8A7;" />
                            <TextBlock Text="打开外层模态窗口" />
                        </StackPanel>
                    </Button>

                    <Border Style="{StaticResource CodeBlockStyle}">
                        <TextBlock Style="{StaticResource CodeTextStyle}">
// 每一层锁住的是「打开它的那个窗口」，而不是写死的主窗口
var owner = 还开着的最后一个模态窗口 ?? 主窗口;

// 于是嵌套时锁住的层级自动就是对的：
//   开内层 -> 锁住外层（主窗口本来就是锁的）
//   关内层 -> 只解开外层
WindowHelper.SetEnabled(owner, false);</TextBlock>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ============ 非模态窗口 ============ -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="非模态窗口" />
                    <TextBlock
                        Style="{StaticResource CardCaptionTextStyle}"
                        Text="不锁属主：窗口开着的时候主界面照常能用，可以同时开好几个。代价是没人 await 它 —— 定时器、事件订阅这些收尾工作得自己挂在 Closed 上。" />

                    <StackPanel
                        Margin="0,16,0,0"
                        Orientation="Horizontal"
                        Spacing="10">
                        <Button Command="{x:Bind Vm.OpenModelessWindowCommand}" Style="{StaticResource ToolbarButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontSize="14" Glyph="&#xE8A7;" />
                                <TextBlock Text="打开非模态窗口" />
                            </StackPanel>
                        </Button>

                        <Button Command="{x:Bind Vm.CloseAllModelessCommand}" Style="{StaticResource ToolbarButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontSize="14" Glyph="&#xE74D;" />
                                <TextBlock Text="全部关闭" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <TextBlock
                        Margin="0,10,0,0"
                        Style="{StaticResource CardCaptionTextStyle}"
                        Text="{x:Bind Vm.ModelessSummary, Mode=OneWay}" />

                    <Border Style="{StaticResource CodeBlockStyle}">
                        <TextBlock Style="{StaticResource CodeTextStyle}">
// 非模态：没人 await，所以收尾只能自己管
var body = new HeartbeatBody();
var window = new DialogWindow { Title = "实时心跳", Body = body, CloseButtonText = "关闭窗口" };

window.Closed += (_, _) => body.Stop();   // 定时器不停，它会跟着进程一直跑
_windows.ShowModeless(window);</TextBlock>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ============ 怎么选 ============ -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="提示走对话框，界面走窗口" />
                    <TextBlock
                        Style="{StaticResource CardCaptionTextStyle}"
                        Text="两种弹法都留着是有原因的，别逮着一个用到底。" />

                    <Grid
                        Margin="0,16,0,0"
                        ColumnSpacing="20"
                        RowSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200" />
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Style="{StaticResource CardTitleTextStyle}"
                            Text="场景" />
                        <TextBlock
                            Grid.Row="0"
                            Grid.Column="1"
                            Style="{StaticResource CardTitleTextStyle}"
                            Text="用什么" />
                        <TextBlock
                            Grid.Row="0"
                            Grid.Column="2"
                            Style="{StaticResource CardTitleTextStyle}"
                            Text="为什么" />

                        <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Style="{StaticResource CardCaptionTextStyle}"
                            Text="一句提示、一个确认" />
                        <TextBlock
                            Grid.Row="1"
                            Grid.Column="1"
                            Style="{StaticResource CardCaptionTextStyle}"
                            Text="IDialogService（ContentDialog）" />
                        <TextBlock
                            Grid.Row="1"
                            Grid.Column="2"
                            Style="{StaticResource CardCaptionTextStyle}"
                            Text="位置和尺寸都不用操心，而且多个调用会自动排队。" />

                        <TextBlock
                            Grid.Row="2"
                            Grid.Column="0"
                            Style="{StaticResource CardCaptionTextStyle}"
                            Text="内容多、要么能拖能改大小" />
                        <TextBlock
                            Grid.Row="2"
                            Grid.Column="1"
                            Style="{StaticResource CardCaptionTextStyle}"
                            Text="DialogWindow（模态）" />
                        <TextBlock
                            Grid.Row="2"
                            Grid.Column="2"
                            Style="{StaticResource CardCaptionTextStyle}"
                            Text="ContentDialog 装不下一整张表单，也不给你改尺寸。" />

                        <TextBlock
                            Grid.Row="3"
                            Grid.Column="0"
                            Style="{StaticResource CardCaptionTextStyle}"
                            Text="开着它还要操作主界面" />
                        <TextBlock
                            Grid.Row="3"
                            Grid.Column="1"
                            Style="{StaticResource CardCaptionTextStyle}"
                            Text="DialogWindow（非模态）" />
                        <TextBlock
                            Grid.Row="3"
                            Grid.Column="2"
                            Style="{StaticResource CardCaptionTextStyle}"
                            Text="不锁属主，代价是收尾得自己管（定时器、事件）。" />

                        <TextBlock
                            Grid.Row="4"
                            Grid.Column="0"
                            Style="{StaticResource CardCaptionTextStyle}"
                            Text="要同时开着好几个" />
                        <TextBlock
                            Grid.Row="4"
                            Grid.Column="1"
                            Style="{StaticResource CardCaptionTextStyle}"
                            Text="只有窗口能做到" />
                        <TextBlock
                            Grid.Row="4"
                            Grid.Column="2"
                            Style="{StaticResource CardCaptionTextStyle}"
                            Text="同一个线程上同时只能开一个 ContentDialog。" />
                    </Grid>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</views:PageBase>
