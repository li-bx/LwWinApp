<?xml version="1.0" encoding="utf-8"?>
<views:PageBase
    x:Class="LwWinApp.Views.Settings.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:LwWinApp.Controls"
    xmlns:views="using:LwWinApp.Views"
    mc:Ignorable="d">

    <ScrollViewer Padding="24" VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="900" HorizontalAlignment="Left" Spacing="16">

            <controls:PageHeader
                Title="关于"
                Description="框架版本、运行环境与目录位置。" />

            <!-- ============ 应用信息 ============ -->
            <Border Style="{StaticResource CardStyle}">
                <Grid ColumnSpacing="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!--
                        应用标记用图标本体，跟标题栏、任务栏是同一张图。
                        外面那一层 BrandSubtleBrush + CornerRadius 的底去掉了：
                        圆角画在图里，再垫一层浅色方块会在图标的透明圆角处透出来。
                    -->
                    <Image
                        Grid.Column="0"
                        Width="72"
                        Height="72"
                        VerticalAlignment="Top"
                        Source="ms-appx:///Assets/AppIcon.png"
                        Stretch="Uniform" />

                    <StackPanel Grid.Column="1" Spacing="10">
                        <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="{x:Bind Vm.AppName}" />
                        <TextBlock
                            Style="{StaticResource CardCaptionTextStyle}"
                            Text="{x:Bind VersionText}" />

                        <TextBlock
                            Style="{StaticResource TableCellTextStyle}"
                            Text="基于 WinUI 3 / Windows App SDK 的桌面应用框架：左侧一级导航 + 顶部多标签二级导航，MVVM + Dapper 泛型仓储，开箱即用的工具库与示例页面。"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ============ 运行环境 ============ -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Style="{StaticResource CardTitleTextStyle}" Text="运行环境" />

                    <Grid ColumnSpacing="16" RowSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Style="{StaticResource FormLabelTextStyle}"
                            Text="应用版本" />
                        <TextBlock
                            Grid.Row="0"
                            Grid.Column="1"
                            Style="{StaticResource TableCellTextStyle}"
                            Text="{x:Bind Vm.AppVersion}" />

                        <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Style="{StaticResource FormLabelTextStyle}"
                            Text="运行时" />
                        <TextBlock
                            Grid.Row="1"
                            Grid.Column="1"
                            Style="{StaticResource TableCellTextStyle}"
                            Text="{x:Bind Vm.RuntimeInfo}"
                            TextWrapping="Wrap" />

                        <TextBlock
                            Grid.Row="2"
                            Grid.Column="0"
                            Style="{StaticResource FormLabelTextStyle}"
                            Text="操作系统" />
                        <TextBlock
                            Grid.Row="2"
                            Grid.Column="1"
                            Style="{StaticResource TableCellTextStyle}"
                            Text="{x:Bind Vm.OperatingSystem}"
                            TextWrapping="Wrap" />

                        <TextBlock
                            Grid.Row="3"
                            Grid.Column="0"
                            Style="{StaticResource FormLabelTextStyle}"
                            Text="进程架构" />
                        <TextBlock
                            Grid.Row="3"
                            Grid.Column="1"
                            Style="{StaticResource TableCellTextStyle}"
                            Text="{x:Bind Vm.ProcessArchitecture}" />

                        <TextBlock
                            Grid.Row="4"
                            Grid.Column="0"
                            Style="{StaticResource FormLabelTextStyle}"
                            Text="配置文件" />
                        <TextBlock
                            Grid.Row="4"
                            Grid.Column="1"
                            Style="{StaticResource TableCellTextStyle}"
                            Text="{x:Bind Vm.SettingsFilePath}"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="Wrap" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ============ 技术栈 ============ -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Style="{StaticResource CardTitleTextStyle}" Text="技术栈" />

                    <ItemsControl ItemsSource="{x:Bind TechStack}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <Grid Padding="0,5" ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <FontIcon
                                        Grid.Column="0"
                                        FontSize="12"
                                        Foreground="{ThemeResource SuccessBrush}"
                                        Glyph="&#xE73E;" />

                                    <TextBlock
                                        Grid.Column="1"
                                        Style="{StaticResource TableCellTextStyle}"
                                        Text="{x:Bind}"
                                        TextWrapping="Wrap" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- ============ 快捷键 ============ -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Style="{StaticResource CardTitleTextStyle}" Text="快捷键" />

                    <Grid ColumnSpacing="16" RowSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Style="{StaticResource TableCellTextStyle}"
                            Text="Ctrl + W" />
                        <TextBlock
                            Grid.Row="0"
                            Grid.Column="1"
                            Style="{StaticResource TableCellTextStyle}"
                            Text="关闭当前标签页" />

                        <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Style="{StaticResource TableCellTextStyle}"
                            Text="Ctrl + Tab" />
                        <TextBlock
                            Grid.Row="1"
                            Grid.Column="1"
                            Style="{StaticResource TableCellTextStyle}"
                            Text="切换到下一个标签页" />

                        <TextBlock
                            Grid.Row="2"
                            Grid.Column="0"
                            Style="{StaticResource TableCellTextStyle}"
                            Text="Ctrl + 数字键" />
                        <TextBlock
                            Grid.Row="2"
                            Grid.Column="1"
                            Style="{StaticResource TableCellTextStyle}"
                            Text="跳转到第 N 个标签页（1~8，9 表示最后一个）" />
                    </Grid>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</views:PageBase>
