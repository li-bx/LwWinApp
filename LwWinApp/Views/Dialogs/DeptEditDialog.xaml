<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="LwWinApp.Views.Dialogs.DeptEditDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="新增部门"
    PrimaryButtonText="保存"
    CloseButtonText="取消"
    DefaultButton="Primary"
    mc:Ignorable="d">

    <StackPanel Width="400">

        <InfoBar
            x:Name="ErrorBar"
            Margin="0,0,0,12"
            IsOpen="False"
            IsClosable="False"
            Severity="Error" />

        <StackPanel Style="{StaticResource FormFieldPanelStyle}">
            <TextBlock Style="{StaticResource FormLabelTextStyle}" Text="上级部门" />
            <ComboBox
                x:Name="ParentBox"
                HorizontalAlignment="Stretch"
                DisplayMemberPath="Text"
                ItemsSource="{x:Bind Model.ParentOptions}"
                SelectedItem="{x:Bind Model.SelectedParent, Mode=TwoWay}" />
            <TextBlock Style="{StaticResource HintTextStyle}" Text="选「顶级部门」即挂在根上。" />
        </StackPanel>

        <StackPanel Style="{StaticResource FormFieldPanelStyle}">
            <TextBlock Style="{StaticResource FormLabelTextStyle}" Text="部门名称 *" />
            <TextBox Text="{x:Bind Model.DeptName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>

        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Style="{StaticResource FormFieldPanelStyle}">
                <TextBlock Style="{StaticResource FormLabelTextStyle}" Text="负责人" />
                <TextBox PlaceholderText="选填" Text="{x:Bind Model.Leader, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>

            <StackPanel Grid.Column="1" Style="{StaticResource FormFieldPanelStyle}">
                <TextBlock Style="{StaticResource FormLabelTextStyle}" Text="排序" />
                <NumberBox
                    Minimum="0"
                    SpinButtonPlacementMode="Compact"
                    Value="{x:Bind Model.Sort, Mode=TwoWay}" />
            </StackPanel>
        </Grid>

        <StackPanel Style="{StaticResource FormFieldPanelStyle}">
            <TextBlock Style="{StaticResource FormLabelTextStyle}" Text="状态" />
            <ComboBox
                HorizontalAlignment="Stretch"
                DisplayMemberPath="Text"
                ItemsSource="{x:Bind Model.StatusOptions}"
                SelectedItem="{x:Bind Model.SelectedStatus, Mode=TwoWay}" />
        </StackPanel>

    </StackPanel>
</ContentDialog>
