    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        图标字形常量，统一取自「Segoe Fluent Icons」字体。

        集中放这里的好处：页面里写 Glyph="{StaticResource IconEdit}" 比写
        Glyph="&#xE70F;" 可读得多，改图标也只改一处。

        用法：<FontIcon Glyph="{StaticResource IconEdit}" />
    -->

    <!-- 导航 -->
    <x:String x:Key="IconHome">&#xE80F;</x:String>
    <x:String x:Key="IconContact">&#xE77B;</x:String>
    <x:String x:Key="IconPeople">&#xE716;</x:String>
