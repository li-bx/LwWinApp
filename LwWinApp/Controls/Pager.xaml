<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="LwWinApp.Controls.Pager"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!--
        分页器。刻意做成「哑控件」：自己不查数据，只负责改页码。
        页码/每页条数通过双向绑定推给 ViewModel，由 ViewModel 决定怎么重新加载。

        功能按钮一律用 Click 事件而不是命令：这里没有业务逻辑，
        用命令只会让每个使用它的页面都得在 ViewModel 里多写两个 RelayCommand。
    -->
    <Grid Padding="4,0" ColumnSpacing="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- 左：统计信息 -->
        <TextBlock
            x:Name="SummaryText"
            Grid.Column="0"
            VerticalAlignment="Center"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Style="{StaticResource CaptionTextBlockStyle}"
            Text="共 0 条" />

        <!-- 右：每页条数 + 跳页 + 翻页 -->
        <StackPanel
            Grid.Column="1"
            Orientation="Horizontal"
            Spacing="12"
            VerticalAlignment="Center">

            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <TextBlock
                    VerticalAlignment="Center"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="每页" />
                <ComboBox
                    x:Name="PageSizeBox"
                    MinWidth="76"
                    SelectionChanged="OnPageSizeSelectionChanged" />
                <TextBlock
                    VerticalAlignment="Center"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="条" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <TextBlock
                    VerticalAlignment="Center"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="跳至" />
                <NumberBox
                    x:Name="JumpBox"
                    Width="84"
                    Minimum="1"
                    SpinButtonPlacementMode="Hidden"
                    ValidationMode="InvalidInputOverwritten" />
                <Button
                    Click="OnJumpClick"
                    Content="跳转"
                    Style="{StaticResource ToolbarButtonStyle}" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                <Button
                    x:Name="FirstButton"
                    Click="OnFirstClick"
                    Style="{StaticResource IconButtonStyle}"
                    ToolTipService.ToolTip="第一页">
                    <FontIcon FontSize="12" Glyph="&#xE892;" />
                </Button>
                <Button
                    x:Name="PreviousButton"
                    Click="OnPreviousClick"
                    Style="{StaticResource IconButtonStyle}"
                    ToolTipService.ToolTip="上一页">
                    <FontIcon FontSize="12" Glyph="&#xE76B;" />
                </Button>

                <TextBlock
                    x:Name="PageIndicator"
                    MinWidth="76"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    TextAlignment="Center"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="1 / 1" />

                <Button
                    x:Name="NextButton"
                    Click="OnNextClick"
                    Style="{StaticResource IconButtonStyle}"
                    ToolTipService.ToolTip="下一页">
                    <FontIcon FontSize="12" Glyph="&#xE76C;" />
                </Button>
                <Button
                    x:Name="LastButton"
                    Click="OnLastClick"
                    Style="{StaticResource IconButtonStyle}"
                    ToolTipService.ToolTip="最后一页">
                    <FontIcon FontSize="12" Glyph="&#xE893;" />
                </Button>
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
